{
  "name": "stagecraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:boundaries && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:canvas": "vitest run --project chromium",
    "sync:officeview": "node scripts/sync-officeview.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:consumer": "node scripts/check-consumer.mjs",
    "test:types": "tsc -p tests/types/tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^25.0.1",
    "konva": "^10.7.1",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "image-size": "2.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
