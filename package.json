{
  "name": "stagecraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:boundaries && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:canvas": "vitest run --project chromium",
    "sync:officeview": "node scripts/sync-officeview.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:consumer": "node scripts/check-consumer.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "konva": "^10.7.1",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
