{
  "name": "@stagecraft/react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./editor": {
      "types": "./src/EditorProvider.d.ts",
      "default": "./src/EditorProvider.jsx"
    },
    "./styles.css": "./src/styles/main.css",
    "./components/*": "./src/components/*",
    "./hooks/*": "./src/hooks/*",
    "./lib/*": "./src/lib/*",
    "./styles/*": "./src/styles/*",
    "./canonical": {
      "types": "./src/CanonicalEditorSurface.d.ts",
      "default": "./src/CanonicalEditorSurface.jsx"
    },
    "./presentation": {
      "types": "./src/PresentationEditor.d.ts",
      "default": "./src/PresentationEditor.jsx"
    },
    "./konva": {
      "types": "./src/konva/KonvaPresentationCanvas.d.ts",
      "default": "./src/konva/KonvaPresentationCanvas.jsx"
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@stagecraft/core": "0.1.0",
    "@stagecraft/renderer": "0.1.0",
    "@stagecraft/source": "0.1.0",
    "konva": "^10.7.1",
    "react-konva": "^18.2.16"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
